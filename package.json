{
  "name": "resqnet-monorepo",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm --prefix backend run dev\" \"npm --prefix frontend run dev\"",
    "build": "npm --prefix backend run build && npm --prefix frontend run build",
    "test": "npm --prefix backend run test",
    "db:push": "npm --prefix backend run db:push",
    "db:seed": "npm --prefix backend run db:seed",
    "db:init": "npm --prefix backend run db:init",
    "lint": "npm --prefix backend run lint"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  }
}
